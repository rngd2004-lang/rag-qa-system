# 复制为 .env 并填入你的 API Key
# cp .env.example .env

# DeepSeek API (推荐: 便宜、中文好、兼容 OpenAI SDK)
API_KEY=sk-your-deepseek-api-key
BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat
# Embedding 使用本地 HuggingFace 模型（免费、中文优化、首次自动下载 ~100MB）

# 如果用 OpenAI:
# API_KEY=sk-your-openai-api-key
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# Chroma 向量库路径
CHROMA_DIR=./data/chroma_db
# 文档上传目录
UPLOAD_DIR=./data/uploads
# 分块参数
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
